# Selecto CASE Expressions Workbook

## Setup 1) Install Dependencies

Run this cell first. It installs the local `selecto_livebooks` project and its
current Selecto dependencies for this Livebook session.

```elixir
Code.require_file(Path.expand("support/bootstrap.exs", __DIR__))
SelectoLivebooksNotebookBootstrap.install!()
```

## Overview

This workbook focuses on SQL `CASE` projections generated through Selecto.

1. `case_when_select/3` for condition-driven buckets
2. `case_select/4` for value-to-label mapping
3. Combining CASE output with sorting and limits

```mermaid
flowchart LR
  row[Order row]
  conditions[CASE conditions]
  label[Computed label]
  output[Row + label column]

  row --> conditions --> label --> output
```

```mermaid
graph TD
  total[order total]
  high[high_value]
  medium[medium_value]
  low[low_value]

  total -->|>= 1000| high
  total -->|>= 500| medium
  total -->|< 500| low
```

Before running, initialize the sample database:

```bash
mix setup
```

## Setup 2) Connect to Repo and Build Order Domain

This cell defines a local Repo and order-focused domain for CASE examples.

```elixir
defmodule CaseLab.Repo do
  use Ecto.Repo,
    otp_app: :case_lab_livebook,
    adapter: Ecto.Adapters.Postgres
end

defmodule CaseLab.OrderDomain do
  @moduledoc false

  def domain do
    %{
      name: "Orders",
      source: %{
        source_table: "orders",
        primary_key: :id,
        fields: [
          :id,
          :order_number,
          :status,
          :total,
          :shipping_country,
          :inserted_at,
          :customer_id
        ],
        columns: %{
          id: %{type: :integer},
          order_number: %{type: :string},
          status: %{type: :string},
          total: %{type: :decimal},
          shipping_country: %{type: :string},
          inserted_at: %{type: :utc_datetime},
          customer_id: %{type: :integer}
        },
        associations: %{}
      },
      schemas: %{},
      joins: %{},
      default_selected: ["order_number", "status", "total", "shipping_country"],
      default_order_by: [{"total", :desc}]
    }
  end
end

repo_config = [
  database: System.get_env("SELECTO_LIVEBOOKS_DB", "selecto_livebooks_dev"),
  username: System.get_env("SELECTO_LIVEBOOKS_DB_USER", "postgres"),
  password: System.get_env("SELECTO_LIVEBOOKS_DB_PASS", "postgres"),
  hostname: System.get_env("SELECTO_LIVEBOOKS_DB_HOST", "localhost"),
  port: String.to_integer(System.get_env("SELECTO_LIVEBOOKS_DB_PORT", "5432")),
  pool_size: 5
]

case Process.whereis(CaseLab.Repo) do
  nil -> {:ok, _pid} = CaseLab.Repo.start_link(repo_config)
  _pid -> :ok
end

config = %{
  repo: CaseLab.Repo,
  order_domain: CaseLab.OrderDomain.domain()
}

{:ok, result} = Ecto.Adapters.SQL.query(config.repo, "select count(*) from orders", [])
[[order_count]] = result.rows
IO.puts("Connected. Orders in dataset: #{order_count}")

config
```

## Setup 3) Define CASE Helpers

This helper cell prints SQL/params and executes a query with a compact preview.

```elixir
defmodule CaseLab.Helpers do
  @moduledoc false

  def explain(label, query) do
    {sql, params} = Selecto.to_sql(query)

    IO.puts("\n=== #{label} ===")
    IO.puts(String.trim(sql))
    IO.puts("Params: #{inspect(params)}")

    {sql, params}
  end

  def run(label, query, preview_count \\ 10) do
    explain(label, query)

    case Selecto.execute(query) do
      {:ok, {rows, columns, aliases}} = ok ->
        IO.puts("Rows: #{length(rows)}")
        IO.puts("Columns: #{inspect(columns)}")
        IO.puts("Aliases: #{inspect(aliases)}")
        IO.inspect(Enum.take(rows, preview_count), label: "Preview (up to #{preview_count} rows)")
        ok

      {:error, error} = failure ->
        IO.puts("Error: #{inspect(error)}")
        failure
    end
  end

  def run_shape(label, query, preview_count \\ 10) do
    explain(label, query)

    case Selecto.execute_shape(query) do
      {:ok, rows} = ok ->
        IO.puts("Rows: #{length(rows)}")
        IO.inspect(Enum.take(rows, preview_count), label: "Preview (up to #{preview_count} shaped rows)")
        ok

      {:error, error} = failure ->
        IO.puts("Error: #{inspect(error)}")
        failure
    end
  end
end
```

## 1) Conditional Buckets with `case_when_select/3`

Classify each order by monetary threshold into `high_value`, `medium_value`, or `low_value`.

```elixir
size_bucket_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(["order_number", "status", "total"])
  |> Selecto.case_when_select([
    {[{"total", {:>=, Decimal.new("1000")}}], "high_value"},
    {[{"total", {:>=, Decimal.new("500")}}], "medium_value"},
    {[{"total", {:<, Decimal.new("500")}}], "low_value"}
  ], else: "unknown", as: "order_size")
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(15)

CaseLab.Helpers.run("CASE WHEN bucket by total", size_bucket_query)
```

## 2) Value Mapping with `case_select/4`

Map raw `status` values into simplified workflow buckets.

```elixir
status_bucket_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(["order_number", "status", "total"])
  |> Selecto.case_select("status", [
    {"processing", "Open"},
    {"shipped", "In Transit"},
    {"delivered", "Closed"},
    {"cancelled", "Closed"}
  ], else: "Other", as: "status_bucket")
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(15)

CaseLab.Helpers.run("Simple CASE status mapping", status_bucket_query)
```

## 3) CASE + Filtering + Sorting

Combine CASE output with additional relational filters to focus on high-value operational views.

```elixir
focused_case_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(["order_number", "status", "total", "shipping_country"])
  |> Selecto.case_when_select([
    {[{"total", {:>=, Decimal.new("1000")}}], "priority"},
    {[{"total", {:>=, Decimal.new("500")}}], "standard"},
    {[{"total", {:<, Decimal.new("500")}}], "light"}
  ], else: "other", as: "value_tier")
  |> Selecto.filter({"status", {:in, ["processing", "shipped", "delivered"]}})
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(20)

CaseLab.Helpers.run("CASE tiers with operational filter", focused_case_query)
```

## 4) Side-by-Side CASE Strategy Comparison

Run two queries (conditional case vs simple case) to compare generated SQL and output semantics.

```elixir
comparison_queries = [
  {
    "Conditional CASE",
    Selecto.configure(config.order_domain, config.repo)
    |> Selecto.select(["order_number", "status", "total"])
    |> Selecto.case_when_select([
      {[{"total", {:>=, Decimal.new("1000")}}], "high_value"},
      {[{"total", {:>=, Decimal.new("500")}}], "medium_value"},
      {[{"total", {:<, Decimal.new("500")}}], "low_value"}
    ], else: "unknown", as: "bucket")
    |> Selecto.limit(8)
  },
  {
    "Simple CASE",
    Selecto.configure(config.order_domain, config.repo)
    |> Selecto.select(["order_number", "status", "total"])
    |> Selecto.case_select("status", [
      {"processing", "Open"},
      {"shipped", "In Transit"},
      {"delivered", "Closed"},
      {"cancelled", "Closed"}
    ], else: "Other", as: "bucket")
    |> Selecto.limit(8)
  }
]

Enum.each(comparison_queries, fn {label, query} ->
  CaseLab.Helpers.run(label, query, 5)
end)

:ok
```

## 6) CASE Buckets with Window Ranking

CASE-derived labels can sit beside analytical window columns for ranked
reporting.

```elixir
case_window_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(["order_number", "status", "total"])
  |> Selecto.case_when_select([
    {[{"total", {:>=, 500}}], "enterprise"},
    {[{"total", {:>=, 200}}], "growth"},
    {[{"total", {:>=, 75}}], "standard"}
  ], else: "starter", as: "value_bucket")
  |> Selecto.window_function(:row_number, [],
    over: [partition_by: ["status"], order_by: [{"total", :desc}]],
    as: "status_value_rank"
  )
  |> Selecto.order_by({"status", :asc})
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(20)

CaseLab.Helpers.run("CASE bucket with status ranking", case_window_query, 10)
```

## 7) Aggregate by CASE-Derived Tier

Use the same tier boundaries in a grouped report to move from row labeling to
summary analysis.

```elixir
tiered_order_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.case_when_select([
    {[{"total", {:>=, 500}}], "enterprise"},
    {[{"total", {:>=, 200}}], "growth"},
    {[{"total", {:>=, 75}}], "standard"}
  ], else: "starter", as: "value_bucket")
  |> Selecto.select([
    {:field, {:raw_sql, "COUNT(*)"}, "order_count"},
    {:field, {:raw_sql, "SUM(selecto_root.total)"}, "gross_total"}
  ])
  |> Selecto.group_by([{:raw_sql, "value_bucket"}])

CaseLab.Helpers.run("Aggregate by CASE-derived tier", tiered_order_query, 10)
```

## 8) Nested CASE Output Shape

`select_shape/2` can package ordinary fields and CASE aliases into nested
containers for downstream UI or API consumption.

```elixir
case_shape_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select_shape([
    "order_number",
    {
      "status",
      {:field,
       {:raw_sql,
        "CASE selecto_root.status WHEN 'processing' THEN 'Open' WHEN 'shipped' THEN 'In Transit' WHEN 'delivered' THEN 'Closed' WHEN 'cancelled' THEN 'Closed' ELSE 'Other' END"},
       "status_bucket"}
    },
    {
      "total",
      {:field,
       {:raw_sql,
        "CASE WHEN selecto_root.total >= 500 THEN 'enterprise' WHEN selecto_root.total >= 200 THEN 'growth' ELSE 'standard' END"},
       "value_bucket"}
    }
  ])
  |> Selecto.limit(8)

CaseLab.Helpers.run_shape("Nested CASE shape", case_shape_query, 8)
```

## 9) Threshold Challenge Inputs

Treat these threshold variables like values a Livebook input would provide, then
feed them into a searched CASE expression.

```elixir
premium_threshold = Decimal.new("750")
growth_threshold = Decimal.new("300")

threshold_case_sql = """
CASE
  WHEN selecto_root.total >= #{premium_threshold} THEN 'premium'
  WHEN selecto_root.total >= #{growth_threshold} THEN 'growth'
  ELSE 'standard'
END
"""

threshold_challenge_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select([
    "order_number",
    "total",
    {:field, {:raw_sql, threshold_case_sql}, "challenge_bucket"}
  ])
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(12)

CaseLab.Helpers.run("Threshold challenge buckets", threshold_challenge_query, 12)
```

## 10) Simple CASE vs Searched CASE

Simple CASE compares one expression to fixed values. Searched CASE evaluates
full predicates, which is better for ranges and compound rules.

```elixir
simple_case_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select([
    "order_number",
    "status",
    {:field,
     {:raw_sql,
      "CASE selecto_root.status WHEN 'processing' THEN 'Open' WHEN 'shipped' THEN 'Moving' WHEN 'delivered' THEN 'Done' ELSE 'Exception' END"},
     "simple_case_label"}
  ])
  |> Selecto.limit(6)

searched_case_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select([
    "order_number",
    "total",
    {:field,
     {:raw_sql,
      "CASE WHEN selecto_root.total >= 750 THEN 'premium' WHEN selecto_root.total >= 300 THEN 'growth' ELSE 'standard' END"},
     "searched_case_label"}
  ])
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(6)

CaseLab.Helpers.explain("Simple CASE SQL", simple_case_query)
CaseLab.Helpers.explain("Searched CASE SQL", searched_case_query)
```

## 11) Order by CASE-Derived Business Priority

Use CASE in `ORDER BY` to sort operational priority before ordinary tie-breakers.

```elixir
priority_order_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select([
    "order_number",
    "status",
    "total",
    {:field,
     {:raw_sql,
      "CASE selecto_root.status WHEN 'processing' THEN 1 WHEN 'shipped' THEN 2 WHEN 'delivered' THEN 3 ELSE 4 END"},
     "business_priority"}
  ])
  |> Selecto.order_by({{:raw_sql, "CASE selecto_root.status WHEN 'processing' THEN 1 WHEN 'shipped' THEN 2 WHEN 'delivered' THEN 3 ELSE 4 END"}, :asc})
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(12)

CaseLab.Helpers.run("CASE-derived business priority", priority_order_query, 12)
```

## 12) Threshold Inputs with Kino Controls

Use `Kino.Input` controls for interactive thresholds, with defaults that also
run cleanly during unattended verification.

```elixir
premium_input = Kino.Input.number("Premium threshold", default: 750)
growth_input = Kino.Input.number("Growth threshold", default: 300)

read_input_or_default = fn input, default ->
  try do
    Kino.Input.read(input) || default
  rescue
    _ -> default
  end
end

premium_threshold = read_input_or_default.(premium_input, 750)
growth_threshold = read_input_or_default.(growth_input, 300)

interactive_threshold_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select([
    "order_number",
    "total",
    {:field,
     {:raw_sql,
      "CASE WHEN selecto_root.total >= #{premium_threshold} THEN 'premium' WHEN selecto_root.total >= #{growth_threshold} THEN 'growth' ELSE 'standard' END"},
     "interactive_bucket"}
  ])
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(10)

CaseLab.Helpers.run("Interactive threshold CASE", interactive_threshold_query, 10)
```

## 13) Nullable Date Buckets

CASE expressions are a useful way to make nullable lifecycle dates explicit.

```elixir
nullable_date_bucket_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select([
    "order_number",
    "status",
    {:field, {:raw_sql, "selecto_root.shipped_at"}, "shipped_at"},
    {:field, {:raw_sql, "selecto_root.delivered_at"}, "delivered_at"},
    {:field,
     {:raw_sql,
      "CASE WHEN selecto_root.shipped_at IS NULL THEN 'not shipped' WHEN selecto_root.delivered_at IS NULL THEN 'in transit' ELSE 'delivered' END"},
     "date_bucket"}
  ])
  |> Selecto.order_by({"inserted_at", :desc})
  |> Selecto.limit(12)

CaseLab.Helpers.run("Nullable date CASE buckets", nullable_date_bucket_query, 12)
```

## 14) CASE Priority vs VALUES Lookup Priority

Compare inline CASE ordering with a small VALUES lookup table for the same
business priority.

```elixir
{:ok, priority_compare} =
  Ecto.Adapters.SQL.query(config.repo, """
  WITH priority_lookup(status, priority_rank) AS (
    VALUES ('processing', 1), ('shipped', 2), ('delivered', 3), ('cancelled', 4)
  )
  SELECT
    orders.order_number,
    orders.status,
    CASE orders.status WHEN 'processing' THEN 1 WHEN 'shipped' THEN 2 WHEN 'delivered' THEN 3 ELSE 4 END AS case_rank,
    priority_lookup.priority_rank AS values_rank
  FROM orders
  LEFT JOIN priority_lookup ON priority_lookup.status = orders.status
  ORDER BY values_rank, orders.total DESC
  LIMIT 12
  """, [])

priority_compare.rows
```

