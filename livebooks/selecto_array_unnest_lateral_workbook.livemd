# Selecto Array, UNNEST, and LATERAL Workbook

## Setup 1) Install Dependencies

Run this cell first. It installs the local `selecto_livebooks` project and its
current Selecto dependencies for this Livebook session.

```elixir
Code.require_file(Path.expand("support/bootstrap.exs", __DIR__))
SelectoLivebooksNotebookBootstrap.install!()
```

## Overview

This workbook covers array-centric query patterns and row-expansion techniques.

1. Array projections (`array_select`)
2. Array filtering (`array_filter`)
3. Array transformations (`array_manipulate`)
4. `UNNEST` expansion to row-level output
5. Explicit `LATERAL` joins (subquery/function forms)

```mermaid
flowchart LR
  base[Product rows]
  arr[array columns]
  arrops[Array operations]
  unnest[UNNEST or LATERAL expansion]
  rows[Expanded analytic rows]

  base --> arr --> arrops --> rows
  arr --> unnest --> rows
```

```mermaid
graph TD
  product[one product row]
  tags[array of tags]
  t1[tag row 1]
  t2[tag row 2]
  t3[tag row 3]

  product --> tags --> t1
  product --> tags --> t2
  product --> tags --> t3
```

Before running, initialize the sample database:

```bash
mix setup
```

## Setup 2) Connect to Repo and Build Product Domain

This cell defines a local Repo and a product domain with `tags` and `metadata` fields.

```elixir
defmodule ArrayLab.Repo do
  use Ecto.Repo,
    otp_app: :array_lab_livebook,
    adapter: Ecto.Adapters.Postgres
end

defmodule ArrayLab.ProductDomain do
  @moduledoc false

  def domain do
    %{
      name: "Products",
      source: %{
        source_table: "products",
        primary_key: :id,
        fields: [
          :id,
          :name,
          :sku,
          :price,
          :stock_quantity,
          :reorder_level,
          :active,
          :featured,
          :tags,
          :metadata,
          :inserted_at
        ],
        columns: %{
          id: %{type: :integer},
          name: %{type: :string},
          sku: %{type: :string},
          price: %{type: :decimal},
          stock_quantity: %{type: :integer},
          reorder_level: %{type: :integer},
          active: %{type: :boolean},
          featured: %{type: :boolean},
          tags: %{type: {:array, :string}},
          metadata: %{type: :jsonb},
          inserted_at: %{type: :utc_datetime}
        },
        associations: %{}
      },
      schemas: %{},
      joins: %{},
      default_selected: ["name", "sku", "tags"],
      default_order_by: [{"name", :asc}]
    }
  end
end

repo_config = [
  database: System.get_env("SELECTO_LIVEBOOKS_DB", "selecto_livebooks_dev"),
  username: System.get_env("SELECTO_LIVEBOOKS_DB_USER", "postgres"),
  password: System.get_env("SELECTO_LIVEBOOKS_DB_PASS", "postgres"),
  hostname: System.get_env("SELECTO_LIVEBOOKS_DB_HOST", "localhost"),
  port: String.to_integer(System.get_env("SELECTO_LIVEBOOKS_DB_PORT", "5432")),
  pool_size: 5
]

case Process.whereis(ArrayLab.Repo) do
  nil -> {:ok, _pid} = ArrayLab.Repo.start_link(repo_config)
  _pid -> :ok
end

config = %{
  repo: ArrayLab.Repo,
  product_domain: ArrayLab.ProductDomain.domain()
}

{:ok, result} = Ecto.Adapters.SQL.query(config.repo, "select count(*) from products", [])
[[product_count]] = result.rows
IO.puts("Connected. Products in dataset: #{product_count}")

config
```

## Setup 3) Define Helpers

This helper cell prints SQL/params and executes a query with a compact preview.

```elixir
defmodule ArrayLab.Helpers do
  @moduledoc false

  def explain(label, query) do
    {sql, params} = Selecto.to_sql(query)

    IO.puts("\n=== #{label} ===")
    IO.puts(String.trim(sql))
    IO.puts("Params: #{inspect(params)}")

    {sql, params}
  end

  def run(label, query, preview_count \\ 10) do
    explain(label, query)

    case Selecto.execute(query) do
      {:ok, {rows, columns, aliases}} = ok ->
        IO.puts("Rows: #{length(rows)}")
        IO.puts("Columns: #{inspect(columns)}")
        IO.puts("Aliases: #{inspect(aliases)}")
        IO.inspect(Enum.take(rows, preview_count), label: "Preview (up to #{preview_count} rows)")
        ok

      {:error, error} = failure ->
        IO.puts("Error: #{inspect(error)}")
        failure
    end
  end

  def run_shape(label, query, preview_count \\ 10) do
    explain(label, query)

    case Selecto.execute_shape(query) do
      {:ok, rows} = ok ->
        IO.puts("Rows: #{length(rows)}")
        IO.inspect(Enum.take(rows, preview_count), label: "Preview (up to #{preview_count} shaped rows)")
        ok

      {:error, error} = failure ->
        IO.puts("Error: #{inspect(error)}")
        failure
    end
  end
end
```

## 1) Array Projections and Overlap Filtering

Use `array_select` to derive metrics from `tags` and `array_filter` to keep products whose tags overlap a target set.

```elixir
array_projection_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(["name", "sku", "tags"])
  |> Selecto.array_select([
    {:array_length, "tags", 1, as: "tag_count"},
    {:array_to_string, "tags", ", ", as: "tag_list"}
  ])
  |> Selecto.array_filter({:array_overlap, "tags", ["electronics", "outdoor"]})
  |> Selecto.order_by({"name", :asc})
  |> Selecto.limit(10)

ArrayLab.Helpers.run("Array projections + overlap filter", array_projection_query)
```

## 2) Array Transformations with `array_manipulate/3`

Transform arrays in-place for downstream usage without mutating stored data.

```elixir
array_manipulation_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(["name", "tags"])
  |> Selecto.array_manipulate([
    {:array_append, "tags", "featured_livebook", [as: "tags_plus_featured"]},
    {:array_remove, "tags", "outdoor", [as: "tags_without_outdoor"]},
    {:array_to_string, "tags", " | ", [as: "tags_pipe"]}
  ])
  |> Selecto.filter({"active", true})
  |> Selecto.limit(10)

ArrayLab.Helpers.run("Array manipulation", array_manipulation_query)
```

## 3) Expand Tags with `UNNEST`

`UNNEST` converts each tag value into its own row while preserving the source product context.

```elixir
unnest_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select([
    "name",
    {:field, {:raw_sql, "product_tag"}, "product_tag"}
  ])
  |> Selecto.unnest("tags", as: "product_tag")
  |> Selecto.filter({"active", true})
  |> Selecto.order_by({"name", :asc})
  |> Selecto.limit(20)

ArrayLab.Helpers.run("UNNEST tag expansion", unnest_query)
```

## 4) Explicit LATERAL Join with UNNEST

This uses `lateral_join/5` directly instead of `unnest/2` convenience.

```elixir
lateral_unnest_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select([
    "name",
    {:field, {:raw_sql, "tag_expanded"}, "product_tag"}
  ])
  |> Selecto.filter({"active", true})
  |> Selecto.lateral_join(:inner, {:unnest, "selecto_root.tags"}, "tag_expanded")
  |> Selecto.order_by({"name", :asc})
  |> Selecto.limit(20)

ArrayLab.Helpers.run("Explicit lateral unnest", lateral_unnest_query)
```

## 5) LATERAL Function Form (`generate_series`)

Use lateral function form to generate per-row derived slots from each product id.

```elixir
generate_series_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select([
    "id",
    "name",
    {:field, {:raw_sql, "period_slot"}, "period_slot"}
  ])
  |> Selecto.filter({"active", true})
  |> Selecto.filter({"id", {:<=, 3}})
  |> Selecto.lateral_join(:inner, {:function, :generate_series, [1, "selecto_root.id"]}, "period_slot")
  |> Selecto.order_by({"id", :asc})
  |> Selecto.limit(20)

ArrayLab.Helpers.run("Lateral generate_series", generate_series_query)
```

## 7) Grouped Analytics After UNNEST

After expanding product tags, group on the unnested value to build a frequency
distribution.

```elixir
tag_frequency_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.unnest("tags", as: "tag")
  |> Selecto.select([
    {:field, {:raw_sql, "tag"}, "tag"},
    {:field, {:raw_sql, "COUNT(*)"}, "product_count"}
  ])
  |> Selecto.group_by([{:raw_sql, "tag"}])
  |> Selecto.order_by({{:count, "*"}, :desc})
  |> Selecto.limit(20)

ArrayLab.Helpers.run("Tag frequency after UNNEST", tag_frequency_query)
```

## 8) Hybrid Array and JSON Conditions

Combine array-aware filters with JSON metadata filters to answer mixed
attribute questions.

```elixir
hybrid_array_json_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(["id", "name", "tags", "metadata"])
  |> Selecto.array_filter({:array_contains, "tags", ["electronics"]})
  |> Selecto.json_filter({:json_contains, "metadata", %{"warehouse" => %{"zone" => "in_stock"}}})
  |> Selecto.order_by({"id", :asc})
  |> Selecto.limit(10)

ArrayLab.Helpers.run("Array + JSON hybrid filter", hybrid_array_json_query)
```

## 9) Nested Shape for Array-Derived Output

Use `select_shape/2` to keep root product fields separate from array-derived
values.

```elixir
array_shape_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.unnest("tags", as: "tag", ordinality: "tag_position")
  |> Selecto.select([
    "id",
    "name",
    {:field, {:raw_sql, "tag"}, "tag"},
    {:field, {:raw_sql, "tag_position"}, "tag_position"}
  ])
  |> Selecto.select_shape([
    "id",
    "name",
    {{:field, {:raw_sql, "tag"}, "tag"}, {:field, {:raw_sql, "tag_position"}, "tag_position"}}
  ])
  |> Selecto.order_by({"id", :asc})
  |> Selecto.limit(20)

ArrayLab.Helpers.run_shape("Nested array-derived shape", array_shape_query)
```

## 10) UNNEST vs JSON Array Expansion

Compare native PostgreSQL arrays with JSON array expansion side by side. The
result shape is intentionally the same: one product row becomes many analytic
rows.

```elixir
{:ok, native_tags} =
  Ecto.Adapters.SQL.query(config.repo, """
  SELECT p.name, tag_value, tag_position
  FROM products p
  CROSS JOIN LATERAL unnest(p.tags) WITH ORDINALITY AS tags(tag_value, tag_position)
  ORDER BY p.name, tag_position
  LIMIT 12
  """, [])

{:ok, json_flags} =
  Ecto.Adapters.SQL.query(config.repo, """
  SELECT p.name, flag_value, flag_position
  FROM products p
  CROSS JOIN LATERAL jsonb_array_elements_text(p.metadata -> 'flags')
    WITH ORDINALITY AS flags(flag_value, flag_position)
  ORDER BY p.name, flag_position
  LIMIT 12
  """, [])

%{
  native_array_rows: native_tags.rows,
  json_array_rows: json_flags.rows
}
```

## 11) Preserve Empty Arrays with Left Lateral Joins

Use `LEFT JOIN LATERAL` when empty arrays should remain visible in the result
instead of disappearing during expansion.

```elixir
{:ok, preserved_empty_arrays} =
  Ecto.Adapters.SQL.query(config.repo, """
  WITH sample_products(id, name, tags) AS (
    VALUES
      (1, 'Tagged sample', ARRAY['alpha', 'beta']::text[]),
      (2, 'Empty sample', ARRAY[]::text[])
  )
  SELECT sample_products.name, expanded.tag_value
  FROM sample_products
  LEFT JOIN LATERAL unnest(sample_products.tags) AS expanded(tag_value) ON true
  ORDER BY sample_products.id, expanded.tag_value
  """, [])

preserved_empty_arrays.rows
```

## 12) Challenge: Rank Tags Within Each Price Band

This challenge expands product tags, groups them by a metadata-derived price
band, then ranks the most common tags within each band.

```elixir
{:ok, ranked_tags} =
  Ecto.Adapters.SQL.query(config.repo, """
  WITH expanded_tags AS (
    SELECT
      p.metadata ->> 'price_band' AS price_band,
      tag_value
    FROM products p
    CROSS JOIN LATERAL unnest(p.tags) AS tags(tag_value)
  ),
  tag_counts AS (
    SELECT price_band, tag_value, count(*) AS product_count
    FROM expanded_tags
    GROUP BY price_band, tag_value
  )
  SELECT
    price_band,
    tag_value,
    product_count,
    row_number() OVER (
      PARTITION BY price_band
      ORDER BY product_count DESC, tag_value ASC
    ) AS tag_rank
  FROM tag_counts
  ORDER BY price_band, tag_rank
  LIMIT 20
  """, [])

ranked_tags.rows
```

## 13) Helper-Style Lateral Expansion Specs

Until JSON array expansion has a first-class Selecto wrapper, keep the raw SQL
fragments small and named so they can be swapped for helper calls later.

```elixir
lateral_specs = [
  %{
    label: "native tags",
    from: "products p",
    lateral: "unnest(p.tags) WITH ORDINALITY AS expanded(value, position)",
    selected: ["p.name", "expanded.value", "expanded.position"]
  },
  %{
    label: "json flags",
    from: "products p",
    lateral: "jsonb_array_elements_text(p.metadata -> 'flags') WITH ORDINALITY AS expanded(value, position)",
    selected: ["p.name", "expanded.value", "expanded.position"]
  }
]

Enum.map(lateral_specs, fn spec ->
  sql = """
  SELECT #{Enum.join(spec.selected, ", ")}
  FROM #{spec.from}
  CROSS JOIN LATERAL #{spec.lateral}
  ORDER BY p.name, expanded.position
  LIMIT 5
  """

  {:ok, result} = Ecto.Adapters.SQL.query(config.repo, sql, [])
  %{label: spec.label, rows: result.rows}
end)
```

## 14) Timing: Overlap Filter vs Expanded Grouping

Compare a direct array overlap filter with an expanded-tag grouping query.

```elixir
timed_query = fn label, sql, params ->
  {microseconds, {:ok, result}} =
    :timer.tc(fn -> Ecto.Adapters.SQL.query(config.repo, sql, params) end)

  %{query: label, elapsed_ms: Float.round(microseconds / 1000, 3), rows: length(result.rows)}
end

[
  timed_query.(
    "array overlap",
    "SELECT id, name FROM products WHERE tags && $1::varchar[]",
    [["electronics", "outdoor"]]
  ),
  timed_query.(
    "expanded grouping",
    """
    SELECT tag_value, count(*)
    FROM products p
    CROSS JOIN LATERAL unnest(p.tags) AS tags(tag_value)
    GROUP BY tag_value
    ORDER BY count(*) DESC
    """,
    []
  )
]
|> Kino.DataTable.new()
```

## 15) Shaped Ranked Tag Payloads

Turn the ranked-tag challenge rows into nested maps ready for UI display.

```elixir
ranked_tags.rows
|> Enum.map(fn [price_band, tag_value, product_count, tag_rank] ->
  %{
    price_band: price_band,
    tag: %{name: tag_value, rank: tag_rank, product_count: product_count}
  }
end)
|> Kino.DataTable.new()
```

